{
    "family": "brazilian-staging-web",
    "containerDefinitions": [
        {
            "name": "web",
            "image": "440893644165.dkr.ecr.sa-east-1.amazonaws.com/brazilian/web:staging",
            "cpu": 0,
            "portMappings": [
                {
                    "containerPort": 3000,
                    "hostPort": 3000,
                    "protocol": "tcp",
                    "name": "web-3000-tcp"
                }
            ],
            "essential": true,
            "command": [
                "bash",
                "-c",
                "aws s3 cp s3://brazilian-staging-env/ibram-museus-firebase-adminsdk-fbsvc-3a1e5e2974.json /opt/mastodon/config && bundle exec rails db:migrate && bundle exec rails s -p 3000"
            ],
            "environment": [],
            "environmentFiles": [
                {
                    "value": "arn:aws:s3:::brazilian-staging-env/web/.env",
                    "type": "s3"
                }
            ],
            "mountPoints": [],
            "volumesFrom": [],
            "workingDirectory": "/opt/mastodon",
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/brazilian-staging",
                    "awslogs-region": "sa-east-1",
                    "awslogs-stream-prefix": "web"
                }
            },
            "healthCheck": {
                "command": [
                    "CMD-SHELL",
                    "wget -q --spider http://localhost:3000/health || exit 1"
                ],
                "interval": 30,
                "timeout": 5,
                "retries": 3,
                "startPeriod": 60
            },
            "systemControls": []
        }
    ],
    "taskRoleArn": "arn:aws:iam::440893644165:role/brazilian-staging-ecs-task",
    "executionRoleArn": "arn:aws:iam::440893644165:role/brazilian-staging-ecs-execution",
    "networkMode": "awsvpc",
    "volumes": [],
    "placementConstraints": [],
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "512",
    "memory": "3072",
    "tags": [
        {
            "key": "Project",
            "value": "brazilian"
        },
        {
            "key": "Environment",
            "value": "staging"
        },
        {
            "key": "Service",
            "value": "web"
        },
        {
            "key": "ManagedBy",
            "value": "terraform"
        },
        {
            "key": "Name",
            "value": "brazilian-staging-web-task"
        }
    ]
}